{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "TwoCoasts design tokens (W3C Design Tokens Community Group format). Import into Figma Tokens / Tokens Studio, Style Dictionary, or read directly.",
  "color": {
    "navy":       { "$type": "color", "$value": "#0B2545", "$description": "Gulf Navy. Primary." },
    "teal":       { "$type": "color", "$value": "#0FA3B1", "$description": "Andaman Teal. Primary accent." },
    "teal-deep":  { "$type": "color", "$value": "#0B7F8A", "$description": "Deep Teal. Accessible teal for text and buttons." },
    "lagoon":     { "$type": "color", "$value": "#8EDCD9", "$description": "Lagoon. Light tint." },
    "gold":       { "$type": "color", "$value": "#D9A64A", "$description": "Dubai Gold. Secondary accent." },
    "gold-light": { "$type": "color", "$value": "#EFC65E", "$description": "Sunlit Gold. Illustration only." },
    "gold-deep":  { "$type": "color", "$value": "#B8862E", "$description": "Bunker Gold. Gold text on light." },
    "sand":       { "$type": "color", "$value": "#F6ECD9", "$description": "Sand. Warm light surface." },
    "ivory":      { "$type": "color", "$value": "#FCFAF5", "$description": "Ivory. Page background." },
    "green":      { "$type": "color", "$value": "#2F9E6B", "$description": "Fairway Green. Success." },
    "coral":      { "$type": "color", "$value": "#F0715F", "$description": "Sunset Coral. Error / alert." },
    "charcoal":   { "$type": "color", "$value": "#1E2A3A", "$description": "Charcoal. Body text, dark surfaces." },
    "driftwood":  { "$type": "color", "$value": "#7A7266", "$description": "Driftwood. Secondary text, borders." },
    "white":      { "$type": "color", "$value": "#FFFFFF" }
  },
  "semantic": {
    "light": {
      "bg":            { "$type": "color", "$value": "{color.ivory}" },
      "surface":       { "$type": "color", "$value": "{color.white}" },
      "surface-warm":  { "$type": "color", "$value": "{color.sand}" },
      "text":          { "$type": "color", "$value": "{color.charcoal}" },
      "heading":       { "$type": "color", "$value": "{color.navy}" },
      "text-muted":    { "$type": "color", "$value": "{color.driftwood}" },
      "link":          { "$type": "color", "$value": "{color.teal-deep}" },
      "primary":       { "$type": "color", "$value": "{color.teal-deep}" },
      "primary-text":  { "$type": "color", "$value": "{color.white}" },
      "accent":        { "$type": "color", "$value": "{color.gold}" },
      "border":        { "$type": "color", "$value": "#E6DCC8" },
      "success":       { "$type": "color", "$value": "{color.green}" },
      "danger":        { "$type": "color", "$value": "{color.coral}" },
      "focus":         { "$type": "color", "$value": "{color.teal}" }
    },
    "dark": {
      "bg":            { "$type": "color", "$value": "#071A33" },
      "surface":       { "$type": "color", "$value": "{color.navy}" },
      "surface-warm":  { "$type": "color", "$value": "#123A63" },
      "text":          { "$type": "color", "$value": "{color.sand}" },
      "heading":       { "$type": "color", "$value": "{color.white}" },
      "text-muted":    { "$type": "color", "$value": "#A9B4C4" },
      "link":          { "$type": "color", "$value": "{color.lagoon}" },
      "primary":       { "$type": "color", "$value": "{color.teal}" },
      "primary-text":  { "$type": "color", "$value": "{color.navy}" },
      "accent":        { "$type": "color", "$value": "{color.gold}" },
      "border":        { "$type": "color", "$value": "#1F3F66" },
      "success":       { "$type": "color", "$value": "#4CBF8A" },
      "danger":        { "$type": "color", "$value": "#FF8A78" },
      "focus":         { "$type": "color", "$value": "{color.gold}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Montserrat", "Avenir Next", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "SF Pro Text", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "SF Mono", "Menlo", "Consolas", "monospace"] }
    },
    "weight": {
      "regular":   { "$type": "fontWeight", "$value": 400 },
      "medium":    { "$type": "fontWeight", "$value": 500 },
      "semibold":  { "$type": "fontWeight", "$value": 600 },
      "bold":      { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "size": {
      "xs":   { "$type": "dimension", "$value": "0.75rem" },
      "sm":   { "$type": "dimension", "$value": "0.875rem" },
      "md":   { "$type": "dimension", "$value": "1rem" },
      "lg":   { "$type": "dimension", "$value": "1.125rem" },
      "xl":   { "$type": "dimension", "$value": "1.375rem" },
      "2xl":  { "$type": "dimension", "$value": "1.75rem" },
      "3xl":  { "$type": "dimension", "$value": "2.25rem" },
      "4xl":  { "$type": "dimension", "$value": "3rem" },
      "5xl":  { "$type": "dimension", "$value": "4rem" }
    },
    "line-height": {
      "tight":  { "$type": "number", "$value": 1.1 },
      "snug":   { "$type": "number", "$value": 1.25 },
      "normal": { "$type": "number", "$value": 1.55 }
    },
    "tracking": {
      "tight": { "$type": "dimension", "$value": "-0.02em" },
      "caps":  { "$type": "dimension", "$value": "0.18em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.5rem" },
    "6": { "$type": "dimension", "$value": "2rem" },
    "7": { "$type": "dimension", "$value": "3rem" },
    "8": { "$type": "dimension", "$value": "4rem" },
    "9": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "20px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "card":  { "$type": "shadow", "$value": { "color": "#0B254514", "offsetX": "0", "offsetY": "4px", "blur": "16px", "spread": "0" } },
    "float": { "$type": "shadow", "$value": { "color": "#0B254529", "offsetX": "0", "offsetY": "12px", "blur": "32px", "spread": "-4px" } }
  },
  "logo": {
    "clear-space": { "$type": "dimension", "$value": "0.5x", "$description": "Minimum clear space around any logo = half the mark's height on all sides." },
    "min-width": {
      "horizontal": { "$type": "dimension", "$value": "120px", "$description": "Digital minimum for twocoasts-logo-primary. Print: 30 mm." },
      "stacked":    { "$type": "dimension", "$value": "80px",  "$description": "Digital minimum for the stacked logo. Print: 20 mm." },
      "mark":       { "$type": "dimension", "$value": "24px",  "$description": "Digital minimum for the mark. Below 32 px use favicon.svg (simplified)." }
    }
  }
}
